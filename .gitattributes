# 统一换行符：仓库内文本默认 LF
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 源码 / 文档显式声明为文本
*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.ino   text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.pro   text eol=lf

# 二进制：不做任何换行/文本转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.mp4   binary
*.apk   binary
*.bin   binary
*.pptx  binary
*.stl   binary
*.zip   binary
